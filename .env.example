# =====================================================================
# AI 서버 환경변수 템플릿
#
#   cp .env.example .env
#
# 실제 키는 여기 적지 않는다. 값은 각자 .env 나 시크릿 저장소에만 둔다.
# =====================================================================

# ---------- 필수: 없으면 기동 실패 ----------

# 같은 PostgreSQL 을 본다. 스프링은 JDBC URL, 여기는 asyncpg URL 이라 형식만 다르다.
AI_DB_URL=postgresql+asyncpg://pairing:pairing@localhost:5432/pairing

# 스프링과 공유하는 내부 호출 키. 스프링이 X-Internal-Api-Key 헤더로 보낸다.
#   생성: openssl rand -hex 32
INTERNAL_API_KEY=

# Google AI Studio 키. 백엔드와 같은 키를 쓴다.
GEMINI_API_KEY=

# ---------- 모델 (용도별로 바꾼다) ----------
GEMINI_MODEL_EMBEDDING=text-embedding-004
GEMINI_MODEL_MATCHING=gemini-2.0-flash
GEMINI_MODEL_REVIEW=gemini-2.0-flash
GEMINI_MODEL_NEGOTIATION=gemini-2.5-flash

# 임베딩 모델을 바꾸면 이 값과 DB 의 vector(768) 컬럼을 함께 바꿔야 한다.
EMBEDDING_DIMENSION=768

# ---------- 선택 ----------
APP_ENV=local
APP_PORT=8000
LOG_LEVEL=INFO
DB_ECHO=false

SPRING_BASE_URL=http://localhost:8080
SPRING_TIMEOUT_SECONDS=5
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=2
