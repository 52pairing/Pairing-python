# =====================================================================
# AI 서버 환경변수 템플릿
#
#   cp .env.example .env
#
# 실제 키는 여기 적지 않는다. 값은 각자 .env 나 시크릿 저장소에만 둔다.
# =====================================================================

# ---------- 필수: 없으면 기동 실패 ----------

# 같은 PostgreSQL 을 본다. 스프링은 JDBC URL, 여기는 asyncpg URL 이라 형식만 다르다.
AI_DB_URL=postgresql+asyncpg://pairing:pairing@localhost:5432/pairing

# 스프링과 공유하는 내부 호출 키. 스프링이 X-Internal-Api-Key 헤더로 보낸다.
#   생성: openssl rand -hex 32
INTERNAL_API_KEY=

# Google AI Studio 키. 백엔드와 같은 키를 쓴다.
#
# 쉼표로 여러 개를 넣을 수 있다. 앞의 키가 429(한도 초과)를 내면 다음 키로 자동 전환한다.
# 공백은 알아서 잘라내고 중복 키는 무시한다. (중복은 한도를 함께 소진해서 후보가 늘지 않는다)
#   GEMINI_API_KEY=AIza...1,AIza...2,AIza...3
GEMINI_API_KEY=

# 한도에 걸린 키를 다시 쓰기까지 기다리는 시간(초).
# 분당 한도는 60초면 풀리고 일일 한도는 자정까지 안 풀린다. 기본 300초는 그 사이값이다.
GEMINI_KEY_COOLDOWN_SECONDS=300

# ---------- 모델 (용도별로 바꾼다) ----------
GEMINI_MODEL_EMBEDDING=gemini-embedding-001
GEMINI_MODEL_MATCHING=gemini-3.5-flash
GEMINI_MODEL_REVIEW=gemini-3.5-flash-lite
GEMINI_MODEL_NEGOTIATION=gemini-3.6-flash
GEMINI_MODEL_CONTRACT=gemini-3.5-flash

# 임베딩 모델을 바꾸면 이 값과 DB 의 vector(768) 컬럼을 함께 바꿔야 한다.
EMBEDDING_DIMENSION=768

# ---------- 선택 ----------
APP_ENV=local
APP_PORT=8000
LOG_LEVEL=INFO
DB_ECHO=false

SPRING_BASE_URL=http://localhost:8080
SPRING_TIMEOUT_SECONDS=5
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=2

# ---------- AI 스텁 (부하 테스트 전용) ----------
#
# 켜면 Gemini 를 실제로 부르지 않고 스키마에 맞는 더미를 만들어 돌려준다.
# k6 로 AI 경로에 부하를 걸 때 쿼터·비용을 태우지 않기 위한 설정이다.
#
# ★ 켜 둔 채로 잊으면 서비스가 가짜 응답을 준다. 네 겹으로 막아 두었다.
#     1) APP_ENV=prod 이면 기동을 거부한다
#     2) 기동 로그에 [AI_STUB_MODE] 경고가 매번 남는다
#     3) gemini_stub_mode 게이지가 1 이 되어 Grafana 에 드러난다
#     4) 더미 문자열에 "[더미]" 가 박혀 있어 화면에서 바로 보인다
AI_STUB_MODE=false

# 더미가 응답하기까지 흉내낼 지연(ms). 스프링 스레드 점유를 재현하는 다이얼이다.
#   0        순수 인프라 한계 (AI 대기가 없을 때의 상한)
#   3000     빠른 LLM
#   20000    느린 LLM. 톰캣 스레드 고갈이 이 근처에서 드러난다
#   125000   스프링 AI_TIMEOUT_MS(120초) 초과 → 타임아웃·취소 경로 검증
AI_STUB_DELAY_MS=0

# 위 지연에 더할 흔들림(± ms). 0 이면 지연이 한 버킷에만 쌓여 p50/p95/p99 가 구분되지 않는다.
AI_STUB_JITTER_MS=0

# 시도마다 판정하는 실패율(0.0~1.0). 서킷브레이커와 재시도 그래프를 볼 때만 쓴다.
# 0.5 로 두면 재시도가 대부분을 구제해서 최종 실패는 훨씬 적게 나온다(실측 20호출 중 3건).
AI_STUB_FAIL_RATE=0.0
